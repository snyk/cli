FROM alpine:3 AS builder

ARG SNYK_BINARY

RUN apk --no-cache add ca-certificates busybox-static
COPY ${SNYK_BINARY} /usr/local/bin/snyk
RUN chmod +x /usr/local/bin/snyk

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /bin/busybox.static /bin/busybox
COPY --from=builder /usr/local/bin/snyk /usr/local/bin/snyk
ENV PATH="/usr/local/bin:/bin"
ENTRYPOINT ["/bin/busybox", "sh"]
